<Window x:Class="B2BIntegratorClassic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:B2BIntegratorClassic.App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- Zauważ, że nie mamy tu żadnych gotowych flag, po prostu bindowanie tekstu -->
        <TextBlock Text="{Binding StatusMessage}" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" />

        <!-- Bindowanie naszej ręcznej komendy -->
        <Button Content="Zmień tekst (Test)" 
                Command="{Binding ZmienTekstCommand}" 
                Padding="20,10" 
                FontSize="14"/>

    </StackPanel>
</Window>
